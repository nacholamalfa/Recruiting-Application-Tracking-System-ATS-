{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["FIREBASE_PROJECT_ID", "FIREBASE_CLIENT_EMAIL", "FIREBASE_PRIVATE_KEY"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "app/**/*.ts",
        "app/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "vitest.config.ts",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "test:regression": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "app/**/*.ts",
        "app/**/*.tsx",
        "**/__tests__/**/*.regression.test.ts",
        "**/__tests__/**/*.regression.test.tsx",
        "vitest.regression.config.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["FIRESTORE_EMULATOR_HOST", "FUNCTIONS_EMULATOR", "GCLOUD_PROJECT"]
    }
  }
}
